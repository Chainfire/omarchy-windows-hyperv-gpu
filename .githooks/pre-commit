#!/bin/bash
# Enforce this repo's line-ending policy on staged files.
#
# Default is CRLF. See .gitattributes: this repo stores bytes verbatim so the
# GitHub "Download ZIP" extracts .bat files that Windows can actually run.
#
# Two exceptions, which must be LF:
#   scripts/**  guest-side Linux scripts and unit files -- CRLF breaks them
#   #!...       any shebang file -- a CRLF shebang is unrunnable on Linux
set -u

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT

bad_lf=()	# want CRLF, found a bare LF
bad_crlf=()	# want LF, found a CRLF
while IFS= read -r -d '' f; do
	git cat-file blob ":$f" > "$tmp" 2>/dev/null || continue
	grep -Iq . "$tmp" || continue                       # binary: leave alone

	if [[ $f == scripts/* ]] || [[ $(head -c 2 "$tmp") == '#!' ]]; then
		perl -0777 -ne 'exit(/\r\n/ ? 1 : 0)' "$tmp" || bad_crlf+=("$f")
		continue
	fi

	perl -0777 -ne 'exit(/(?<!\r)\n/ ? 1 : 0)' "$tmp" && continue
	bad_lf+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z)

(( ${#bad_lf[@]} + ${#bad_crlf[@]} == 0 )) && exit 0

{
	if (( ${#bad_lf[@]} )); then
		echo "pre-commit: staged files have LF endings, but this repo requires CRLF:"
		printf '  %s\n' "${bad_lf[@]}"
		echo
		echo "Fix and re-stage:"
		for f in "${bad_lf[@]}"; do
			printf '  sed -i %s %q && git add %q\n' "'s/\$/\\r/'" "$f" "$f"
		done
		echo
	fi

	if (( ${#bad_crlf[@]} )); then
		echo "pre-commit: staged files have CRLF endings, but these must be LF:"
		printf '  %s\n' "${bad_crlf[@]}"
		echo
		echo "Fix and re-stage:"
		for f in "${bad_crlf[@]}"; do
			printf '  sed -i %s %q && git add %q\n' "'s/\\r\$//'" "$f" "$f"
		done
		echo
	fi

	echo "Bypass once with: git commit --no-verify"
} >&2
exit 1
